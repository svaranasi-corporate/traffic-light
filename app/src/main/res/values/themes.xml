<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Base application theme.
        The Compose MaterialTheme (Material 3 / dark) is applied in code;
        this XML theme only needs to satisfy the Activity window background
        before Compose takes over.
    -->
    <style name="Theme.TrafficLight" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
